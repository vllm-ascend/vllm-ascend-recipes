# NOTE: public/status/ and public/runs/ are intentionally NOT ignored.
# They hold CI status fixtures used by local dev and PR preview (Netlify)
# so the badge UI renders before the first real publish-status.yml run
# produces live data. In production publish-status.yml writes the same
# paths on main, overwriting the fixtures on each CI completion.
