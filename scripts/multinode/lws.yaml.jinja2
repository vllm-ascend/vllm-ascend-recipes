# LWS skeleton for the multi-node PD recipe verify pipeline.
#
# Aligned with upstream vllm-project/vllm-ascend
# tests/e2e/nightly/multi_node/scripts/lws.yaml.jinja2. Rendered by
# scripts/multinode/controller.py (render_lws) via simple string substitution
# (no jinja2 dependency on the controller runner). The pod spec — hostNetwork,
# 910B4 node affinity, NPU resource, hostPath weights, entry ConfigMap — is
# generated by controller._pod_spec() and injected into the LEADER_SPEC /
# WORKER_SPEC placeholders below (same spec for leader and workers).
apiVersion: leaderworkerset.x-k8s.io/v1
kind: LeaderWorkerSet
metadata:
  name: {{ LWS_NAME }}
  namespace: {{ NAMESPACE }}
spec:
  replicas: 1
  leaderWorkerTemplate:
    size: {{ SIZE }}
    restartPolicy: None
    leaderTemplate:
      metadata:
        labels:
          role: leader
      spec:
{{ LEADER_SPEC }}
    workerTemplate:
      spec:
{{ WORKER_SPEC }}
