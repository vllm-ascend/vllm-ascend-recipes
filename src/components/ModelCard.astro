---
import type { ModelListItem } from '../lib/types';
import { formatContextLength, formatParameters } from '../lib/models';

interface Props {
  model: ModelListItem & {
    /** Optional slug used by VerifyBadge to fetch status. */
    _model_slug?: string;
  };
}

const { model } = Astro.props;
---

<a
  href={model.url}
  class="group relative block p-5 rounded-lg border border-ink-800/60 hover:border-accent-500/30 bg-ink-900/40 hover:bg-ink-900/60 transition-all duration-200 overflow-hidden"
>
  <div
    class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-accent-500/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
  >
  </div>

  <div class="flex items-start gap-2 mb-2">
    <h3
      class="min-w-0 font-display font-semibold text-sm text-ink-100 group-hover:text-accent-300 transition-colors tracking-tight"
    >
      {model.title}
    </h3>
    <div class="ml-auto flex shrink-0 items-center gap-2">
      <span
        class="text-[10px] font-mono uppercase tracking-wider text-ink-500 px-1.5 py-0.5 rounded border border-ink-700/50 flex items-center gap-1"
      >
        {model.architecture}
      </span>
      {
        model._model_slug && (
          <span
            data-model-verification
            data-model-slug={model._model_slug}
            class="inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-ink-600 ring-1 ring-ink-500/50"
            title="No configuration verification"
            aria-label="No configuration verification"
          />
        )
      }
    </div>
  </div>

  <p class="text-xs text-ink-500 line-clamp-2 mb-3 leading-relaxed">
    {model.description}
  </p>

  <div class="flex flex-wrap gap-1.5">
    <span
      class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-accent-500/10 text-accent-400 border border-accent-500/15"
    >
      {formatParameters(model.parameters, model.active_parameters)}
    </span>
    <span
      class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-violet-500/10 text-violet-400 border border-violet-500/15"
    >
      {formatContextLength(model.context_length)}
    </span>
    <span
      class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/15"
    >
      {model.modality}
    </span>
    {
      model.npus
        .slice(0, 2)
        .map((n) => (
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/15">
            {n}
          </span>
        ))
    }
  </div>
</a>

<script>
  import {
    fetchModelStatus,
    summarizeModelVerification,
    verificationDotPresentation,
  } from '../lib/status';

  const allClasses = [
    'bg-emerald-400',
    'ring-emerald-300/50',
    'bg-amber-400',
    'ring-amber-300/50',
    'bg-rose-400',
    'ring-rose-300/50',
    'bg-ink-600',
    'ring-ink-500/50',
  ];

  document.querySelectorAll<HTMLElement>('[data-model-verification]').forEach((dot) => {
    const slug = dot.dataset.modelSlug;
    if (!slug) return;
    fetchModelStatus(slug)
      .then((data) => {
        const presentation = verificationDotPresentation(summarizeModelVerification(data));
        dot.classList.remove(...allClasses);
        dot.classList.add(...presentation.classes);
        dot.title = presentation.label;
        dot.setAttribute('aria-label', presentation.label);
      })
      .catch(() => undefined);
  });
</script>
