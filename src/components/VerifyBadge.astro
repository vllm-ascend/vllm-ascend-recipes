---
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  modelId: string;
  compact?: boolean;
}

const { modelId, compact = false } = Astro.props;

// Try multiple possible paths since build env varies
const paths = [
  'public/verify-status.json',
  './public/verify-status.json',
  join(process.cwd(), 'public', 'verify-status.json'),
];

let status: string | null = null;
let runUrl: string | null = null;

for (const p of paths) {
  try {
    if (existsSync(p)) {
      const data = JSON.parse(readFileSync(p, 'utf-8'));
      const model = data.models?.[modelId];
      if (model) {
        status = model.status;
        runUrl = model.run_url || null;
        break;
      }
    }
  } catch {
    continue;
  }
}

if (!status) return null;

const colors: Record<string, string> = {
  PASS: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  FAIL: 'bg-red-500/10 text-red-400 border-red-500/20',
  SKIP: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
};

const labels: Record<string, string> = {
  PASS: '✓ CI Verified',
  FAIL: '✗ CI Failed',
  SKIP: '⊘ Skipped',
};

const classList = [
  'text-[10px]',
  'font-mono',
  'px-1.5',
  'py-0.5',
  'rounded',
  'border',
  colors[status] || '',
  compact ? '' : 'ml-1',
]
  .filter(Boolean)
  .join(' ');
---

{
  runUrl ? (
    <a
      href={runUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex"
    >
      <span class={classList}>
        {labels[status] || status}
      </span>
    </a>
  ) : (
    <span class={classList}>
      {labels[status] || status}
    </span>
  )
}
